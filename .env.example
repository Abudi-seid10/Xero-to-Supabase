# --- Xero app credentials ---
# Create an app at https://developer.xero.com/app/manage
# Type: "Web app" (Authorization Code flow)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must exactly match a redirect URI configured on the Xero app.
# Only used once, during `npm run setup-auth`.
XERO_REDIRECT_URI=https://localhost:5000/callback

# --- Supabase ---
# Project Settings -> API. Use a Secret key (preferred) or legacy service_role
# key; never expose either in a browser/client app because they bypass RLS.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative, only if you do not use a Secret key:
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Set to a number (MB) to abort a run early as a safety valve against
# an unexpectedly huge first sync. Leave blank to disable.
MAX_SYNC_MINUTES=
