# --- Xero app credentials ---
# Create an app at https://developer.xero.com/app/manage
# Type: "Web app" (Authorization Code flow)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must exactly match a redirect URI configured on the Xero app.
# Only used once, during `npm run setup-auth`.
XERO_REDIRECT_URI=http://localhost:5000/callback

# --- Supabase ---
# Project Settings -> API. Use a Secret key (preferred) or legacy service_role
# key; never expose either in a browser/client app because they bypass RLS.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative, only if you do not use a Secret key:
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Set to a number (MB) to abort a run early as a safety valve against
# an unexpectedly huge first sync. Leave blank to disable.
MAX_SYNC_MINUTES=

# --- Frappe / ERPNext export (npm run export:frappe) ---
# Exact Company name in Frappe that the documents will be imported into.
FRAPPE_COMPANY=
FRAPPE_CUSTOMER_GROUP=All Customer Groups
FRAPPE_SUPPLIER_GROUP=All Supplier Groups
FRAPPE_TERRITORY=All Territories
# Frappe account that receives Xero's tax total (e.g. "VAT - ABC"). Optional but recommended.
FRAPPE_SALES_TAX_ACCOUNT=
FRAPPE_PURCHASE_TAX_ACCOUNT=
# Optional JSON file mapping Xero account codes to Frappe accounts: {"200": "Sales - ABC", "400": "Advertising - ABC"}
FRAPPE_ACCOUNT_MAP_FILE=
# Output folder (default ./export, git-ignored)
EXPORT_DIR=

# --- Frappe API (only for npm run upload:attachments) ---
FRAPPE_URL=https://your-site.example.com
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# --- QuickBooks Online (npm run export:qbo) ---
# From developer.intuit.com -> your app -> Keys & credentials (use Production keys for real data).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Company ID shown in the OAuth Playground / top-right company menu in QuickBooks.
QBO_REALM_ID=
QBO_ENVIRONMENT=production
# Easiest: leave these two blank and run `npm run setup-qbo-auth`, which stores the token and prints the company ID.
# Alternatively seed a refresh token from the OAuth Playground. QuickBooks rotates it on every use,
# so the current one is kept in .qbo-auth-<companyId>.json after the first run.
QBO_REFRESH_TOKEN=
# Optional: redirect URI for setup-qbo-auth (default: the Intuit OAuth Playground's, always accepted).
QBO_REDIRECT_URI=
